<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: must be alpha-only (monochrome). The system tints it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
        android:width="24dp"
        android:height="24dp"
        android:viewportWidth="24"
        android:viewportHeight="24">

    <!-- Sun path above the horizon -->
    <path
        android:pathData="M21,14 A9,9 0 0 0 3,14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />

    <!-- Horizon -->
    <path
        android:pathData="M2,14 L22,14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round" />

    <!-- Dhuhr: zenith -->
    <path
        android:pathData="M12,5 m-2.4,0 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 z"
        android:fillColor="#FFFFFFFF" />

    <!-- Asr -->
    <path
        android:pathData="M7.2,6.4 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 z"
        android:fillColor="#FFFFFFFF" />

</vector>
