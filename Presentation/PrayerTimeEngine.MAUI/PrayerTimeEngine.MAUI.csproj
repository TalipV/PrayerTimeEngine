<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PrayerTimeEngine</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- the texts in Presentation/Localization/AppResources.resx are German; translations go into
         AppResources.<culture>.resx (e.g. AppResources.en.resx) and are picked by the device language -->
    <NeutralLanguage>de</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- typed access to the texts (AppResources.Menu_Title, ...), generated by MSBuild on every build,
         so it works the same in Visual Studio, on the command line and on CI -->
    <EmbeddedResource Update="Presentation\Localization\AppResources.resx"
                      StronglyTypedLanguage="CSharp"
                      StronglyTypedNamespace="PrayerTimeEngine.Presentation.Localization"
                      StronglyTypedClassName="AppResources"
                      StronglyTypedFileName="$(IntermediateOutputPath)AppResources.Designer.cs"
                      PublicClass="true" />
  </ItemGroup>

  <!-- On Windows, WinUI's XamlPreCompile compiles the C# code inside PrepareResources, before
       CoreResGen has generated AppResources.Designer.cs (=> CS0103 "AppResources" not found).
       Generate the resources first; ResGen then does not run a second time. -->
  <Target Name="GenerateResourcesBeforeXamlPreCompile"
          BeforeTargets="XamlPreCompile"
          DependsOnTargets="PrepareResourceNames;ResGen"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'" />

  <PropertyGroup>
    <ApplicationTitle>PrayerTimeEngine</ApplicationTitle>
    <ApplicationId>com.companyname.prayertimeengine</ApplicationId>
    <ApplicationIdGuid>c83b767d-745b-4d09-b7ca-65e9b6575d10</ApplicationIdGuid>
    <!-- Versions (see "Versioning" in CLAUDE.md). ApplicationDisplayVersion is raised by hand;
         CI overrides ApplicationVersion (Android versionCode) with the workflow run number. -->
    <ApplicationDisplayVersion>0.9.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-ios'))">
    <CreatePackage>false</CreatePackage>
  </PropertyGroup>

  <!-- Since .NET 11 the app runs on CoreCLR (Mono is no longer supported). Release builds
       are trimmed and precompiled with composite ReadyToRun by default; by default only part
       of the methods is precompiled, the rest is compiled on the device at runtime.
       Full ReadyToRun precompiles (almost) every method: faster start and fewer runtime
       compilations, at the cost of a larger APK and a longer build. NativeAOT would go
       further but is experimental on Android in .NET 11. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <MauiEnableFullReadyToRun>true</MauiEnableFullReadyToRun>
    <!-- Release APKs go to real phones, which are all arm64; the emulator (x64) gets Debug builds.
         Set here, not on the command line: a global RuntimeIdentifiers would leak into the
         referenced class libraries and break their build (MSB3030). -->
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifiers>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Domain\PrayerTimeEngine.Domain\PrayerTimeEngine.Domain.csproj" />
    <ProjectReference Include="..\..\Application\PrayerTimeEngine.Application\PrayerTimeEngine.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\PrayerTimeEngine.Infrastructure\PrayerTimeEngine.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageReference Include="CommunityToolkit.Maui.Markup" Version="9.0.0" />
    <PackageReference Include="Debounce.Core" Version="1.0.0" />
    <PackageReference Include="Mapsui.Maui" Version="5.1.0" />
    <PackageReference Include="MethodTimer.Fody" Version="3.2.3" PrivateAssets="All" />
    <PackageReference Include="MetroLog.Maui" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="Plugin.Maui.DebugRainbows" Version="1.2.2" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="All" />
    <PackageReference Include="Refractored.MvvmHelpers" Version="1.6.2" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.156.1" />
    <PackageReference Include="UraniumUI.Material" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B1524" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#101114" BaseSize="128,128" />

    <!-- Images -->

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Images\location.png" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\location.png" />
  </ItemGroup>

</Project>
